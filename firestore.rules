rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'mhrfazle@gmail.com'
          || request.auth.token.admin == true
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    match /adminAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Rules for the active reports collection
    match /reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Rules for the soft-deleted trash items collection
    match /trash/{trashId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Rules for custom user suggestions dictionaries
    // Document ID matches the user's Auth UID (request.auth.uid)
    match /dictionaries/{userId} {
      allow read, write: if isAdmin()
        || (isAuthenticated() && request.auth.uid == userId);
    }

    // Rules for user streaks tracking
    match /streaks/{streakId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Rules for user daily goals
    match /goals/{userId} {
      allow read, write: if isAdmin()
        || (isAuthenticated() && request.auth.uid == userId);
    }

    // Daily active app usage, separate from reports and task completion.
    match /appUsage/{userId}/days/{dateId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Rules for user points system & rewards
    match /points/{userId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Rules for daily journal entries
    match /journals/{journalId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Rules for user-admin messaging center
    match /messages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.receiverId == request.auth.uid || resource.data.receiverId == 'all'));
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && (resource.data.receiverId == request.auth.uid || resource.data.receiverId == 'all'));
      allow delete: if isAdmin();
    }

    // Rules for Admin Profiles (About the Creator)
    match /adminProfiles/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && request.auth.uid == adminId;
    }

    // Rules for dynamic todo app tasks
    match /todos/{todoId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Rules for user wallets
    match /wallets/{userId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
  }
}
